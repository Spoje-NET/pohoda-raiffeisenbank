# Graph (client-id/secret) auth only: by default the uploaded file's URL is a
# permanent sharing link (Graph createLink), which keeps working after the
# file is moved or renamed. Set to 'false' to instead return the upload
# response's `webUrl`, which is path-based and goes stale on move/rename.
#SHAREPOINT_PERMANENT_LINK=true
# Type of sharing link to create: 'view' (read-only) or 'edit'.
#SHAREPOINT_LINK_TYPE=view
# Who the sharing link works for: 'anonymous', 'organization' (default, only
# people in your org), or 'users' (only people already granted access).
#SHAREPOINT_LINK_SCOPE=organization

# Set to 'false' to skip uploading XML statements to SharePoint entirely
# (PDF upload and Pohoda import are unaffected).
#SHAREPOINT_UPLOAD_XML=true
# Optional separate SharePoint destination folder for XML statements; if
# unset, XML goes to the same folder as PDF (OFFICE365_PATH).
#OFFICE365_PATH_XML=

# pohoda-sharepoint-year-archiver: path prefix under which it creates
# per-year subfolders (<prefix>/2025, <prefix>/2024, ...); if unset,
# defaults to OFFICE365_PATH itself.
#OFFICE365_ARCHIVE_PATH=
# pohoda-sharepoint-year-archiver: the year that stays in OFFICE365_PATH;
# if unset, defaults to the current calendar year.
#CURRENT_YEAR=
# pohoda-sharepoint-year-archiver: set to 'true' to actually move files.
# When false (default) it only reports what it would move (dry-run).
#ARCHIVE_APPLY=false
